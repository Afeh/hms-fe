# Optional. By default the dev server proxies /api to http://127.0.0.1:8000.
# VITE_PROXY_TARGET=http://127.0.0.1:8000

# Optional. Set only when the browser talks to the API directly (cross-origin cookies
# require SameSite=None and Secure on the backend). Include the /api/v1 suffix.
# VITE_API_BASE_URL=https://api.example.com/api/v1

# Optional. Origin to embed in phone capture links and QR codes. Defaults to the
# current browser origin, which is wrong for phones when developing on localhost.
# VITE_PUBLIC_APP_URL=https://hms.example.com
